# Copy to .env and fill in. Never commit .env.

# Domain pointing to this VPS (A record).
DOMAIN=fta.trading

# Email of the first admin: an invitation link for it is printed in the app logs at first start.
ADMIN_EMAIL=

# Database password: letters and digits only. Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Image version to run: "latest", or "sha-<commit>" to pin/roll back to a precise build.
APP_TAG=latest
